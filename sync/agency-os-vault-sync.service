# systemd user service: one run of vault-sync.sh. Triggered by agency-os-vault-sync.timer.
# install.sh fills __SCRIPT__ and __REPO__. By hand:
#   cp agency-os-vault-sync.service agency-os-vault-sync.timer ~/.config/systemd/user/
#   (replace the placeholders), then
#   systemctl --user daemon-reload && systemctl --user enable --now agency-os-vault-sync.timer
[Unit]
Description=agency-os vault sync (commit, pull, push)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash __SCRIPT__ __REPO__
Nice=10
IOSchedulingClass=idle
